# Upstream Scrapscache instance URL
SCRAPSCACHE_URL=https://scrapscache.com

# Optional static-vault sync key (Base64URL encoded 32-byte key).
# Leave empty for browser OAuth; this is only used with MCP_BEARER_TOKEN.
SCRAPSCACHE_SYNC_KEY=

# Optional static Bearer Token for local AI clients and scripts. Use at least
# 32 random characters when enabled.
MCP_BEARER_TOKEN=

# Required independent secret used to seal OAuth values. Generate one with:
# openssl rand -hex 32
MCP_SECRET=

# Public HTTPS origin when running behind a reverse proxy, for example:
# MCP_PUBLIC_ORIGIN=https://mcp.example.com

# (Optional) Map of friends' tokens to their sync keys for multi-friend hosting
# MCP_FRIENDS_TOKENS={"token_alice":"syncKeyAlice","token_bob":"syncKeyBob"}

# Port for the MCP server
PORT=3001
