{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "scrapscache",
	"main": "cf/app.ts",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	// Version preview URLs bind the same D1, R2 and Durable Object as production
	// while bypassing every zone-level WAF and rate-limiting rule. Keep them off.
	"preview_urls": false,
	"routes": [
		{
			"pattern": "scrapscache.com/*",
			"zone_name": "scrapscache.com"
		},
		// Turnstile's widget runs here and nowhere else, so its script never shares
		// an origin with the sync keys. The Worker serves only /turnstile on this host.
		{
			"pattern": "verify.scrapscache.com",
			"custom_domain": true
		}
	],
	"vars": {
		"SCRAPSCACHE_ORIGIN": "https://scrapscache.com",
		"SCRAPSCACHE_SYNC_MAX_ACCOUNT_BYTES": "100000000",
		"PUBLIC_TURNSTILE_ORIGIN": "https://verify.scrapscache.com",
		"TURNSTILE_SITEKEY": "0x4AAAAAAEx1iggiE7ZSHoeB",
		// Siteverify reports the host the widget ran on, which is the challenge host.
		"TURNSTILE_HOSTNAMES": "verify.scrapscache.com",
		"SCRAPSCACHE_RETENTION_INACTIVE_DAYS": "365",
		// Only the canonical production origin is crawlable; dev serves Disallow.
		"SCRAPSCACHE_ALLOW_INDEXING": "true"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "SCRAPSCACHE_DB",
			"database_name": "scrapscache",
			"database_id": "c132b1a5-0263-489e-872b-f91f3373d01a",
			"migrations_dir": "cf/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "SCRAPSCACHE_ENVELOPES",
			"bucket_name": "scrapscache-envelopes"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ACCOUNT_COORDINATOR",
				"class_name": "AccountCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AccountCoordinator"]
		}
	],
	"env": {
		"dev": {
			"d1_databases": [
				{
					"binding": "SCRAPSCACHE_DB",
					"database_name": "scrapscache-dev",
					"database_id": "3dd5fae0-a9d1-4476-b2d1-a3936ee57a08",
					"migrations_dir": "cf/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "SCRAPSCACHE_ENVELOPES",
					"bucket_name": "scrapscache-envelopes-dev"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "ACCOUNT_COORDINATOR",
						"class_name": "AccountCoordinator"
					}
				]
			},
			"routes": [
				{
					"pattern": "dev.scrapscache.com/*",
					"zone_name": "scrapscache.com"
				},
				{
					"pattern": "verify-dev.scrapscache.com",
					"custom_domain": true
				}
			],
			"vars": {
				"SCRAPSCACHE_ORIGIN": "https://dev.scrapscache.com",
				"SCRAPSCACHE_SYNC_MAX_ACCOUNT_BYTES": "100000000",
				"PUBLIC_TURNSTILE_ORIGIN": "https://verify-dev.scrapscache.com",
				"TURNSTILE_SITEKEY": "0x4AAAAAAEx1iggiE7ZSHoeB",
				"TURNSTILE_HOSTNAMES": "verify-dev.scrapscache.com",
				"SCRAPSCACHE_RETENTION_INACTIVE_DAYS": "365",
				// Pre-merge code on a public hostname. Never invite crawlers here.
				"SCRAPSCACHE_ALLOW_INDEXING": "false"
			}
		}
	}
}
