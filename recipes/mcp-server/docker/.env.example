# Upstream Scrapscache instance URL
SCRAPSCACHE_URL=https://scrapscache.com

# Your Scrapscache Sync Key (Base64URL encoded 32-byte key)
SCRAPSCACHE_SYNC_KEY=your_sync_key_here

# Static Bearer Token for AI clients (Claude Desktop, Cursor, scripts)
MCP_BEARER_TOKEN=secret_mcp_bearer_token

# (Optional) Map of friends' tokens to their sync keys for multi-friend hosting
# MCP_FRIENDS_TOKENS={"token_alice":"syncKeyAlice","token_bob":"syncKeyBob"}

# Port for the MCP server
PORT=3001
